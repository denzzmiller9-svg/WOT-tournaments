# DB
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=tournaments
DATABASE_URL=postgresql+asyncpg://app_user:replace-with-a-strong-database-password@postgres:5432/tournaments

# JWT
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=45

# Frontend
FRONTEND_HOST=http://localhost
WG_REDIRECT_URI=http://localhost/api/v1/auth/wargaming/callback

# Wargaming.net (OpenID)
WG_APP_ID=replace-with-your-wargaming-application-id
